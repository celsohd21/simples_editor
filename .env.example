# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Flask Configuration
FLASK_ENV=development
DEBUG=1

# JWT Secret (mínimo 64 caracteres para produção)
SECRET_KEY=dev-secret-key-change-in-production-min-64-chars

# Environment
ENVIRONMENT=development
